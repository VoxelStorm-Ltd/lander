# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto

# Explicitly declare text files we want to always be normalized and converted
# to native line endings on checkout.
*.c text eol=native
*.cpp text eol=native
*.h text eol=native
*.hpp text eol=native
*.sh text eol=native
*.txt text eol=native
*.ini text eol=native

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Declare files that will always have LF line endings on checkout.
version.h text eol=lf
*.cbp text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.dll binary
#*.cbp binary
#*.sample binary
#*.xml binary
#*.layout binary

# Make sure version.h is always merged smoothly
version.h merge=highest_version_merge
